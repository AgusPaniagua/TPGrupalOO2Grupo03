<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Pedido" table="pedido">
        <id name="idPedido" column="idPedido">
            <generator class="native"/>
        </id>

        <property name="fechaDeTransaccion" column="fechaDeTransaccion" type="date"/>

        <!-- Relación con UnidadDeVenta -->
        <many-to-one name="unidadDeVenta" class="datos.UnidadDeVenta" column="idUnidadDeVenta"/>

        <!-- Relación con Pedido_plato -->
        <set name="pedidosPlato" cascade="all" inverse="true">
            <key column="idPedido"/>
            <one-to-many class="datos.Pedido_plato"/>
        </set>
    </class>
</hibernate-mapping>