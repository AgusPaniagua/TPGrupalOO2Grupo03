<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Festival" table="festival">
    
        <id name="idFestival" column="idFestival">
            <generator class="identity"/>
        </id>
		<!-- Atributos - Columnas -->
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="temporada" column="temporada" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaInicio" column="fechaInicio" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaFin" column="fechaFin" type="java.time.LocalDate" not-null="true"/>
     
        <one-to-one name="costo" class="datos.Costo"></one-to-one>
        
        <set name="unidadDeVenta"  order-by="idUnidadDeVenta asc" inverse="true" lazy="true" fetch="select">

    	<key column="id_festival" not-null="true"/>
   		<one-to-many class="datos.UnidadDeVenta"/>

		</set>

  </class>    
</hibernate-mapping>
