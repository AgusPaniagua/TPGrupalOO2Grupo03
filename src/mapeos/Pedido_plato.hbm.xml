<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Pedido_plato" table="pedido_plato">
        <id name="idPedido_plato" column="idPedido_plato">
            <generator class="native"/>
        </id>

        <!-- Relación con Pedido -->
        <many-to-one name="pedido" class="datos.Pedido" column="idPedido"/>

        <!-- Relación con Plato -->
        <many-to-one name="plato" class="datos.Plato" column="idPlato"/>

        <property name="subTotal" column="subTotal" type="double"/>
    </class>
</hibernate-mapping>